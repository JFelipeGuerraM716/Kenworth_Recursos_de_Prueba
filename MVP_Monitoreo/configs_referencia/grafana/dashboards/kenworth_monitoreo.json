          "query": "from(bucket: \"seguridad\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wazuh_agentes\" and r._field == \"desconectados\")\n  |> last()"
        }
