    {
      "id": 10,
      "type": "table",
      "title": "Últimas alertas medias y altas",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-seguridad"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-seguridad"
          },
          "query": "from(bucket: \"seguridad\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wazuh_alertas\")\n  |> filter(fn: (r) => r.severidad != \"baja\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"severidad\", \"nivel_num\", \"regla\", \"descripcion\", \"agente\", \"srcip\", \"destino\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)"
        }
      ]
