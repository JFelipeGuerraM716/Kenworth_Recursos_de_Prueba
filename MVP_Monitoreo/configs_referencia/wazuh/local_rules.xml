<!--
  REFERENCIA: reglas personalizadas equivalentes a las del prototipo (pipeline/reglas.py).
  Ubicación en el manager: /var/ossec/etc/rules/local_rules.xml
  Antes de usarlas:
    1. Ajustar los if_sid / if_group al decodificador real de los registros
       (sshd, firewall de la empresa, etc.).
    2. Probar cada regla con /var/ossec/bin/wazuh-logtest.
  Severidad de la propuesta: baja 0-6, media 7-11, alta 12-15.
-->
<group name="kenworth_lab,">

  <!-- Autenticación (sobre las reglas base de sshd: 5716 fallo, 5715 éxito) -->
  <rule id="100020" level="5">
    <if_sid>5716</if_sid>
    <description>Fallo de autenticación</description>
    <group>autenticacion,authentication_failed,</group>
  </rule>

  <rule id="100021" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100020</if_matched_sid>
    <same_srcip />
    <same_user />
    <description>Fallos de autenticación repetidos (5 en 10 min, mismo origen y usuario)</description>
    <mitre><id>T1110</id></mitre>
    <group>autenticacion,fuerza_bruta,</group>
  </rule>

  <rule id="100022" level="12" timeframe="600">
    <if_sid>5715</if_sid>
    <if_matched_sid>100021</if_matched_sid>
    <same_srcip />
    <description>Acceso exitoso después de fallos repetidos</description>
    <mitre><id>T1110</id><id>T1078</id></mitre>
    <group>autenticacion,fuerza_bruta,</group>
  </rule>

  <!-- Horario de prueba 07:00-19:00 -->
  <rule id="100030" level="8">
    <if_sid>5715</if_sid>
    <time>7 pm - 7 am</time>
    <description>Acceso exitoso fuera del horario de prueba</description>
    <mitre><id>T1078</id></mitre>
    <group>autenticacion,horario,</group>
  </rule>

  <!-- Cambio autorizado CH01: origen en la lista CDB etc/lists/cambios_autorizados
       (ventana 02:00-02:30). Baja la severidad pero deja registro para revisión humana. -->
  <rule id="100031" level="4">
    <if_sid>100030</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/cambios_autorizados</list>
    <time>2 am - 2:30 am</time>
    <description>Acceso fuera de horario dentro de un cambio autorizado; cierre por revisión humana</description>
    <group>autenticacion,cambio_autorizado,</group>
  </rule>

  <!-- Firewall: bloqueos y posible reconocimiento -->
  <rule id="100011" level="6">
    <if_group>firewall_drop</if_group>
    <dstip>10.60.20.20|10.60.30.10</dstip>
    <description>Conexión bloqueada hacia un activo sensible</description>
    <group>firewall,bloqueo,</group>
  </rule>

  <rule id="100012" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100011</if_matched_sid>
    <same_srcip />
    <description>Posible reconocimiento: bloqueos repetidos hacia un activo sensible</description>
    <mitre><id>T1046</id></mitre>
    <group>firewall,reconocimiento,</group>
  </rule>

  <!-- Volumen >= 50 MB desde DB-LAB o BACKUP-LAB hacia fuera de 10.60.x.x.
       Wazuh no compara números: el umbral se expresa como expresión regular
       (8 dígitos que empiezan por 5-9, o 9 dígitos o más). -->
  <rule id="100041" level="13">
    <if_group>firewall</if_group>
    <srcip>10.60.20.20|10.60.30.10</srcip>
    <field name="bytes" type="pcre2">^([5-9]\d{7}|\d{9,})$</field>
    <field name="dstip" type="pcre2" negate="yes">^10\.60\.</field>
    <description>Volumen alto desde un activo sensible hacia un destino externo</description>
    <mitre><id>T1048</id></mitre>
    <group>volumen,posible_exfiltracion,</group>
  </rule>

  <!-- Calidad de reglas: R01 solo describe Internet -> WEB-LAB TCP/443 -->
  <rule id="100050" level="7">
    <if_group>firewall</if_group>
    <field name="rule_name">^R01$</field>
    <field name="dstip" type="pcre2" negate="yes">^10\.60\.10\.10$</field>
    <description>El flujo registrado no corresponde a la descripción de R01 (trazabilidad)</description>
    <group>trazabilidad,politica,</group>
  </rule>

  <!-- Uso de la excepción R02 (Usuarios -> DB-LAB any, sin registro) -->
  <rule id="100060" level="7">
    <if_group>firewall</if_group>
    <field name="rule_name">^R02$</field>
    <description>Uso de la excepción R02 (Usuarios -> DB-LAB any, sin registro)</description>
    <group>politica,</group>
  </rule>

</group>
