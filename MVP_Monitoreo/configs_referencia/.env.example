# Copiar como .env y completar. Nunca subir el archivo .env al repositorio.

# InfluxDB
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=cambiar-por-una-clave-larga
INFLUX_ADMIN_TOKEN=cambiar
INFLUX_ORG=kenworth-lab
INFLUX_BUCKET=seguridad
# Crear un token por servicio con el mínimo permiso (influx auth create ...):
INFLUX_WRITE_TOKEN=token-solo-escritura-para-telegraf
INFLUX_READ_TOKEN=token-solo-lectura-para-grafana
INFLUX_IA_TOKEN=token-lectura-escritura-para-la-ia

# API de Wazuh (usuario de solo lectura creado con scripts/crear_usuario_api.sh)
# host.docker.internal = el equipo donde corre el Wazuh manager, visto desde Docker
WAZUH_API_URL=https://host.docker.internal:55000
WAZUH_API_USER=telegraf-ro
WAZUH_API_PASSWORD=Cambiar.Esta1
# Grupo "wazuh" del host: obtener con  getent group wazuh | cut -d: -f3
WAZUH_GID=999

# Grafana y proxy
GRAFANA_DOMINIO=localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar

# Notificaciones
SMTP_USER=cuenta-alertas@gmail.com
SMTP_APP_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
CORREO_ALERTAS=equipo-monitoreo@ejemplo.com
TELEGRAM_BOT_TOKEN=token-entregado-por-BotFather
TELEGRAM_CHAT_ID=-1001234567890
